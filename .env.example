# Ghalem Store Pro — environment configuration
# Copy to .env and fill in. NEVER commit a real .env.

# Port the server listens on
PORT=3000

# Session secret — MUST be a long random string in production.
# The server refuses to boot in production (NODE_ENV=production) without it.
SESSION_SECRET=

# SQLite database file
DB_PATH=./data/ghalem-store.db

# Directory where payment receipts are stored (NOT served publicly)
UPLOAD_DIR=./data/uploads

# development | production
NODE_ENV=development
